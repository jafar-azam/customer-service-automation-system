{
  "name": "@csas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "C.S.A.S API server.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start": "node dist/index.js",
    "seed": "node --env-file-if-exists=../../.env dist/seed/index.js",
    "break-glass": "node --env-file-if-exists=../../.env dist/cli/break-glass-main.js",
    "seed:dev": "node --env-file-if-exists=../../.env --import tsx src/seed/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@csas/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.3",
    "otpauth": "^9.5.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "socket.io": "4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "redis-memory-server": "^0.17.1",
    "socket.io-client": "4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
