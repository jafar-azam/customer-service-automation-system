# Gates every commit: formatting + lint on staged files, a secret scan over the
# staged content, then a full type-check. Type-check is last because it is the
# slowest and the other two catch more mistakes per second.
npx lint-staged
npm run secrets:scan -- --staged

# Local-only real data must never reach a tracked file. Only does anything on a
# machine that holds reference/data/seniordata.csv — which is the only machine
# that can leak it.
npm run scan:personal-data
npm run typecheck
