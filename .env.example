# ──────────────────────────────────────────────────────────────────────────────
# C.S.A.S environment — copy to .env and fill in.
#
#   cp .env.example .env
#
# Every value here is a PLACEHOLDER. The server validates this file's real
# counterpart with zod at startup and refuses to boot on anything missing,
# malformed, or left at a placeholder value when NODE_ENV=production.
#
# Generate a secret with:   openssl rand -hex 32
# Generate a 32-byte key:   openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Pretty, coloured logs for a terminal. Leave false in containers: the log is
# JSON so that it can be parsed, and pino-pretty is not installed in production.
LOG_PRETTY=false
# Asia/Beirut is not cosmetic: SLA timers, business hours and Lebanese public
# holidays are all computed in this zone.
TZ=Asia/Beirut
APP_BASE_URL=http://localhost:8080
# Host port the whole stack is published on (nginx).
APP_PORT=8080
# Host ports for the two services published on 127.0.0.1 for tooling only
# (MongoDB Compass, the ML service's /docs). Change them if something else on
# your machine already owns the default — a native MongoDB install on 27017 is
# the usual collision. Only the host side moves; inside the Compose network the
# ports never change, so no connection string needs editing.
MONGO_HOST_PORT=27017
ML_HOST_PORT=8000
# Comma-separated allow-list. Never use "*" — CORS with credentials requires an
# explicit origin, and a wildcard would hand any site a session.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Data stores ───────────────────────────────────────────────────────────────
# The application connects as a least-privilege user, never as root.
MONGODB_URI=mongodb://csas_app:change-me-app-password@mongo:27017/csas?replicaSet=rs0&authSource=csas
MONGODB_DB=csas
MONGODB_ROOT_USERNAME=csas_root
MONGODB_ROOT_PASSWORD=change-me-root-password
MONGODB_APP_USERNAME=csas_app
MONGODB_APP_PASSWORD=change-me-app-password
# A second identity, used only by `npm run seed` and future migrations. It holds
# dbAdmin on the application database; the application user does not, so a
# compromised server cannot remove a schema validator or drop an index.
MONGODB_MIGRATION_USERNAME=csas_migrator
MONGODB_MIGRATION_PASSWORD=change-me-migration-password
MONGODB_MIGRATION_URI=mongodb://csas_migrator:change-me-migration-password@mongo:27017/csas?replicaSet=rs0&authSource=csas
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

# ── Secrets (32+ characters each, all distinct) ───────────────────────────────
ACCESS_TOKEN_SECRET=change-me-generate-with-openssl-rand-hex-32
REFRESH_TOKEN_SECRET=change-me-generate-a-different-one-hex-32
# Phone numbers are encrypted at rest and looked up by a separate keyed hash,
# so a leaked database does not yield a list of customer phone numbers.
PHONE_ENCRYPTION_KEY=change-me-32-bytes-base64-openssl-rand
PHONE_HASH_PEPPER=change-me-generate-with-openssl-rand-hex-32

# ── First admin (seeded once, idempotently; never wiped) ──────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-12-chars-with-mixed-case-and-digits

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Seeds demo accounts and a FIXED admin TOTP secret, and shows the live 6-digit
# code in the dev inbox so a reviewer can log in within five minutes.
# Mandatory-2FA enforcement itself stays on. Refused outright when
# NODE_ENV=production — there is a test that proves it.
DEMO_MODE=true
DEMO_ADMIN_TOTP_SECRET=CHANGEMEDEMOTOTPSECRET234567

# ── Providers ─────────────────────────────────────────────────────────────────
# Every provider ships a mock. "mock" is the default everywhere so that the app
# and the whole test suite run with zero API keys and no GPU.
#
# No inline comments below this point, or anywhere else in this file: Node's
# --env-file, Docker Compose's env_file and the various dotenv libraries do not
# agree on whether text after a `#` is part of the value. A variable that means
# two different things in two tools is a bug waiting for a deployment.
#
#   LLM_PROVIDER         mock | ollama
#   EMBEDDINGS_PROVIDER  mock | local
#   STT_PROVIDER         mock | whisper
#   TTS_PROVIDER         mock | piper
#   FILE_SCAN_PROVIDER   mock | clamav
#   MESSAGING_PROVIDER   mock  (WhatsApp/SMS remain documented interfaces)
#   EMAIL_PROVIDER       mock
#   STORAGE_PROVIDER     local
#
LLM_PROVIDER=mock
EMBEDDINGS_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
MESSAGING_PROVIDER=mock
EMAIL_PROVIDER=mock
FILE_SCAN_PROVIDER=mock
STORAGE_PROVIDER=local

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
ML_SERVICE_URL=http://ml:8000

# ── Seed data (both paths are git-ignored) ───────────────────────────────────
# TechQA is the publishable seed knowledge base: 621 real support questions with
# human-selected answer spans, under CDLA-Permissive-1.0. 12 GB, so it is
# downloaded rather than committed — see docs/steps/05-data-models.
TECHQA_PATH=data/external/techqa
# Optional, local only. Real business interactions: every imported row is
# flagged publishable:false and lands in the review queue, never approved.
SENIORDATA_PATH=reference/data/seniordata.csv
# Shared secret for service-to-service calls on the internal network.
ML_SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-32
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
STORAGE_ROOT=/var/lib/csas/storage

# Days after a ticket is closed during which a customer may reopen the
# conversation. Reopening creates a new ticket linked to the old one, because
# a closed ticket is a finished record. 0 disables it.
TICKET_REOPEN_WINDOW_DAYS=14

# ── Observability (off by default; nothing is sent anywhere) ──────────────────
ERROR_TRACKING_DSN=
METRICS_ENABLED=true
